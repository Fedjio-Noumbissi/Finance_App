# --- Firebase (client) ---
# Ces variables sont exposées dans le bundle navigateur : c'est normal et sans
# danger pour Firebase Auth (la sécurité vient des règles et des domaines autorisés).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase Admin (serveur) ---
# Paramètres de service account : Firebase Console > Paramètres du projet >
# Comptes de service > Générer une nouvelle clé privée.
# FIREBASE_PRIVATE_KEY contient des \n littéraux à convertir en sauts de ligne.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Base de données ---
# URL de connexion PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"
# Secret de chiffrement du cookie de session (32 caractères min)
SESSION_SECRET="changez-moi-par-une-chaine-aleatoire-de-64-caracteres"
